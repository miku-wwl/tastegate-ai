# The app runs authored synthetic fixtures and, in the owner's local profiles, replays the owner's ignored private recordings read-only.
# Neither mode reads a credential or contacts Qloo. No credentials are needed to run it.
NEXT_TELEMETRY_DISABLED=1
QLOO_MODE=fixture
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_REQUEST_TIMEOUT_MS=4000

# ---- Runtime profile: what this server is allowed to do ----
#   development      owner's machine: recorded replay and the owner-granted live gate are possible          (default for `next dev`)
#   recorded-local   owner shows recorded evidence locally: replay on, live off, no credential allowed
#   test             automated tests: no recordings, no live, no credential
#   production-safe  anything reachable by others: synthetic + custom plans only, recordings never loaded, live off, NO credential  (default for NODE_ENV=production)
#   production-live  RESERVED and refused: public live access is not authorized and cannot be switched on from the environment
# A production build therefore shows no recordings unless you choose a local profile: `TASTEGATE_PROFILE=recorded-local npm start`.
# If your ignored .env.local holds a credential (for the probes), recorded-local would refuse it: use `TASTEGATE_PROFILE=development` and
# `TASTEGATE_DISABLE_LIVE=1` to show recorded evidence without ever allowing a live request.
# An invalid combination (a credential on a profile that must not hold one, a secret-looking NEXT_PUBLIC_ variable, an unknown profile)
# fails closed to production-safe, is reported by /api/health (HTTP 503), and makes `npm run start:prod` refuse to start (exit 78).
TASTEGATE_PROFILE=

# ---- Probes and live ----
# P01-P05, P03-R and P06 are completed and must not be repeated. Any new request (next: P07) needs the owner's exact, single-use approval:
# `npm run probe:p07` only previews; `node scripts/qloo-probe-p07-admin.mjs --prepare-gate` writes the offer and prints the one sentence that approves it.
# Only explicit probe preflight/execution parses ignored .env.local inside local Node; process env wins.
# Keep credentials private; never use NEXT_PUBLIC_QLOO_API_KEY. No-argument preview does not load them.
QLOO_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=

# ---- AUTHORIZED_LIVE (optional, owner-only; off by default; development profile only) ----
# A live Qloo request needs ALL of: TASTEGATE_PROFILE=development, QLOO_MODE=live with QLOO_API_KEY set on the SERVER, an owner-created
# time-boxed grant (npm run live:grant -- --propose ..., then --create --proposal=<id> --owner-reply=<the exact sentence>), and an explicit
# confirmation in the app for each run. Setting a variable, opening the app or pressing a generic button never starts a request.
# A locked or failed live run never falls back to recordings.
# TASTEGATE_DISABLE_LIVE=1 switches live off completely whatever the profile: set it on every public deployment and in automated browser tests.
TASTEGATE_DISABLE_LIVE=
