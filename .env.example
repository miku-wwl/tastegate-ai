# The inspection route always runs authored synthetic fixtures. No credentials are needed.
NEXT_TELEMETRY_DISABLED=1
QLOO_MODE=fixture
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_REQUEST_TIMEOUT_MS=4000
# Server-only loader is ready; live execution stays disabled even with a key.
# The separate raw P01 CLI needs explicit approval and acknowledgment of exposure/unknown entitlement risks.
# Only --preflight-p01 / --execute-p01 parse ignored .env.local inside local Node; process env wins.
# Keep credentials private; never use NEXT_PUBLIC_QLOO_API_KEY. No-argument preview does not load them.
QLOO_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=
