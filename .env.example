# The inspection route always runs authored synthetic fixtures. No credentials are needed.
NEXT_TELEMETRY_DISABLED=1
QLOO_MODE=fixture
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_REQUEST_TIMEOUT_MS=4000
# The semantic LiveQlooAdapter stays disabled even with a key.
# P01 is completed; do not repeat it in Phase 1B.3. P02 needs fresh film confirmation and P02-only approval.
# Only explicit probe preflight/execution parses ignored .env.local inside local Node; process env wins.
# Keep credentials private; never use NEXT_PUBLIC_QLOO_API_KEY. No-argument preview does not load them.
QLOO_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=
