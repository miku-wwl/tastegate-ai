# The app runs authored synthetic fixtures and, when the owner's ignored private recordings exist on the
# server, replays them read-only. Neither mode reads a credential or contacts Qloo. No credentials are needed.
NEXT_TELEMETRY_DISABLED=1
QLOO_MODE=fixture
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_REQUEST_TIMEOUT_MS=4000
# The semantic LiveQlooAdapter stays disabled even with a key.
# P01-P05 and P03-R are completed and must not be repeated. P06 was executed once under a single-use approval. Any new request (next: P07) needs fresh, exact owner approval.
# Only explicit probe preflight/execution parses ignored .env.local inside local Node; process env wins.
# Keep credentials private; never use NEXT_PUBLIC_QLOO_API_KEY. No-argument preview does not load them.
QLOO_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=

# ---- AUTHORIZED_LIVE (optional, owner-only; off by default) ----
# A live Qloo request needs ALL of: QLOO_MODE=live with QLOO_API_KEY set on the SERVER, an owner-created time-boxed grant
# (npm run live:grant -- --create ...), and an explicit confirmation in the app for each run. Setting a variable, opening the
# app or pressing a generic button never starts a request. A locked or failed live run never falls back to recordings.
# TASTEGATE_DISABLE_LIVE=1 switches live off completely: set it on every public deployment and in automated browser tests.
TASTEGATE_DISABLE_LIVE=
