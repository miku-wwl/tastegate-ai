# The inspection route always runs authored synthetic fixtures. No credentials are needed.
NEXT_TELEMETRY_DISABLED=1
QLOO_MODE=fixture
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_REQUEST_TIMEOUT_MS=4000
# Server-only loader is ready; live execution stays disabled even with a key.
# The separate raw P01 CLI additionally requires rotation/rights confirmations and explicit approval.
# Never use NEXT_PUBLIC_QLOO_API_KEY. The probe CLI does not read dotenv files.
QLOO_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=
