# EXAMPLE ONLY. The complete, safe environment for a public-facing TasteGate server. There are no secrets here and there must never be any.
# Copy the values into your platform's configuration; do not commit a filled-in copy.

# Which profile this server runs. production-safe is the default for NODE_ENV=production and the only public profile that is authorized.
# (production-live is reserved and is refused; it cannot be switched on from the environment.)
TASTEGATE_PROFILE=production-safe

# An additional operator kill switch for live requests. The profile already disables them; this makes the intent explicit.
TASTEGATE_DISABLE_LIVE=1

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
# Bind address. The container image sets 0.0.0.0; for a bare process behind a local reverse proxy leave the default 127.0.0.1.
HOSTNAME=0.0.0.0

# --- Variables that must be ABSENT on a public host (the server refuses to start if any is set) --------------------------
# QLOO_API_KEY            a provider credential: a host that must never reach Qloo should not hold the means to
# LLM_API_KEY             likewise
# QLOO_MODE=live          live mode
# NEXT_PUBLIC_*KEY*       a variable with a secret-looking name that the browser bundle would receive
